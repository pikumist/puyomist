{
  "name": "puyomist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:vite",
    "build:wasm": "wasm-pack build packages/solver-wasm --target web",
    "build:vite": "tsc && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "test": "vitest",
    "test-wasm": "cd packages/solver-wasm; cargo test",
    "bench-wasm": "cd packages/solver-wasm; cargo bench",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "server": "tsx server/cli.ts",
    "solver-server": "cd packages/solver-wasm; RUSTFLAGS=\"-C target-cpu=native\" cargo run --release --features server --bin solver-server"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "immer": "^11.1.8",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "p-limit": "^6.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "chokidar": "^4.0.3",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wasm-pack": "^0.15.0",
    "ws": "^8.18.1"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@hono/node-server": "^2.0.10"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "11.16.0"
  }
}
