{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug server/cli.ts with tsx",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--inspect", // デバッグ用に inspector を有効化
        "server/cli.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
